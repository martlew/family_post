# Server
PORT=3000
NODE_ENV=production

# CORS origins of your frontend (comma-separated)
# Supports exact origins; add the current temporary Netlify deploy URL when needed.
FRONTEND_ORIGIN=https://foto-post-weltweit.de,https://www.foto-post-weltweit.de,https://6a566eee41c42012a80dac40--foto-post-weltweit.netlify.app

# Echtpost
ECHTPOST_API_KEY=replace-with-real-key
ECHTPOST_API_URL=https://api.echtpost.de/v2/cards
ECHTPOST_MOTIVE_ID=374

# Lemon Squeezy
PUBLIC_BASE_URL=https://foto-post-weltweit.de
LEMON_SQUEEZY_API_KEY=replace-with-real-key
LEMON_SQUEEZY_STORE_ID=replace-with-store-id
# Leave these unset to use the real default IDs hardcoded in server/index.ts
# (single=1896112, family-5=1896131, benefit-10=1896134).
LEMON_SQUEEZY_VARIANT_ID=replace-with-variant-id
LEMON_SQUEEZY_VARIANT_ID_SINGLE=replace-with-single-variant-id
LEMON_SQUEEZY_VARIANT_ID_FAMILY_5=replace-with-family-5-variant-id
LEMON_SQUEEZY_VARIANT_ID_BENEFIT_10=replace-with-benefit-10-variant-id
LEMON_SQUEEZY_TEST_MODE=true

# PostgreSQL for payment draft persistence
DB_HOST=familypost_db
DB_PORT=5432
DB_NAME=familypost
DB_USER=postgres
DB_PASSWORD=replace-with-postgres-password
DB_SSL=false
# Optional alternative to the individual DB_* fields above:
# DB_URL=postgresql://postgres:replace-with-postgres-password@familypost_db:5432/familypost

# Optional public build-time aliases for a Vite client bundle
VITE_API_URL=https://api.foto-post-weltweit.de
VITE_LEMON_SQUEEZY_STORE_ID=replace-with-store-id
VITE_LEMON_SQUEEZY_VARIANT_ID=replace-with-variant-id

# SMTP for password reset mail
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="Family Post <no-reply@foto-post-weltweit.de>"
SMTP_SECURE=false

# Optional: reserved for future signed JWT tokens
JWT_SECRET=replace-with-long-random-secret
