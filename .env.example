# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# Prodigi Print API (v4.0)
# Set PRODIGI_ENV=sandbox for sandbox testing, leave empty or set to anything else for production.
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox

# Stripe checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only needed if the frontend ever needs the key directly (e.g. Stripe.js Elements);
# the current redirect-based checkout flow does not read this client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: pre-created Stripe Price IDs per plan. If unset, the checkout session
# is created with inline price_data using the hardcoded amounts in server/index.ts.
STRIPE_PRICE_ID_SINGLE=
STRIPE_PRICE_ID_FAMILY_5=
STRIPE_PRICE_ID_BENEFIT_10=

# SMTP (password reset mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Family Post <no-reply@example.com>"
SMTP_SECURE=false

JWT_SECRET=

# Postgres (payment drafts, customer credits, app users).
# DB_PASSWORD must exactly match the POSTGRES_PASSWORD the familypost_db
# container was created with - otherwise checkout draft creation fails with
# "password authentication failed for user postgres". Either set the DB_*
# fields below, or set DB_URL (alias: DATABASE_URL, accepted by deploy.sh)
# to a full connection string instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familypost
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_URL=

VITE_API_URL=http://localhost:3000
