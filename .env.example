# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# MyPostcard B2B API (v1.8)
MYPOSTCARD_API_KEY=
MYPOSTCARD_USERNAME=
MYPOSTCARD_PASSWORD=
MYPOSTCARD_CAMPAIGN_ID=
MYPOSTCARD_API_BASE_URL=https://www.mypostcard.com

# Lemon Squeezy checkout
LEMON_SQUEEZY_API_KEY=
# Defaults to 429090 in code/deploy.sh if left empty (public store ID).
LEMON_SQUEEZY_STORE_ID=429090
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_VARIANT_ID_SINGLE=
LEMON_SQUEEZY_VARIANT_ID_FAMILY_5=
LEMON_SQUEEZY_VARIANT_ID_BENEFIT_10=
LEMON_SQUEEZY_TEST_MODE=true
VITE_LEMON_SQUEEZY_STORE_ID=
VITE_LEMON_SQUEEZY_VARIANT_ID=

# SMTP (password reset mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Family Post <no-reply@example.com>"
SMTP_SECURE=false

JWT_SECRET=

# Postgres (payment drafts, customer credits, app users).
# DB_PASSWORD must exactly match the POSTGRES_PASSWORD the familypost_db
# container was created with - otherwise checkout draft creation fails with
# "password authentication failed for user postgres". Either set the DB_*
# fields below, or set DB_URL (alias: DATABASE_URL, accepted by deploy.sh)
# to a full connection string instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familypost
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_URL=

VITE_API_URL=http://localhost:3000
